---
interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  /** Optional JSON-LD (e.g. WebSite, FAQPage); emit as separate script tags. */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  robots?: string;
  /** Discoverable RSS for this resource (Search can relate HTML pages to feeds). */
  rssAlternate?: { title: string; href: string };
}
const {
  title,
  description = 'RSS feeds for any Hive author, tag, or community. Subscribe in Feedly, NetNewsWire, or any RSS reader.',
  ogImage,
  jsonLd,
  robots = 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1',
  rssAlternate,
} = Astro.props;

const site = Astro.site ?? new URL('https://hiverss.com/');
const siteOrigin = site.origin;

function toAbsoluteImage(src: string | undefined): string | undefined {
  if (!src) return undefined;
  if (/^https?:\/\//i.test(src)) return src;
  if (src.startsWith('//')) return `https:${src}`;
  const path = src.startsWith('/') ? src : `/${src}`;
  return new URL(path, siteOrigin).href;
}

const ogImageAbsolute = toAbsoluteImage(ogImage);

// Align canonical with middleware: /new/tag duplicates /created/tag; Hive accounts are lowercase.
let canonicalPath = Astro.url.pathname;

if (canonicalPath.startsWith('/new/')) {
  const tag = canonicalPath.slice('/new/'.length);
  if (tag && !tag.includes('/')) {
    canonicalPath = `/created/${tag}`;
  }
}

if (canonicalPath.startsWith('/@')) {
  const rest = canonicalPath.slice(2);
  const slashIndex = rest.indexOf('/');
  if (slashIndex === -1) {
    canonicalPath = `/@${rest.toLowerCase()}`;
  } else {
    const user = rest.slice(0, slashIndex).toLowerCase();
    canonicalPath = `/@${user}${rest.slice(slashIndex)}`;
  }
}

const canonicalUrl = new URL(canonicalPath, siteOrigin).href;
const jsonLdBlocks = jsonLd
  ? Array.isArray(jsonLd)
    ? jsonLd
    : [jsonLd]
  : [];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <meta name="theme-color" content="#0B0B0A" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content="en_US" />
    {ogImageAbsolute && <meta property="og:image" content={ogImageAbsolute} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="HiveRSS" />
    <meta
      name="twitter:card"
      content={ogImageAbsolute ? 'summary_large_image' : 'summary'}
    />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImageAbsolute && <meta name="twitter:image" content={ogImageAbsolute} />}
    <meta name="generator" content={Astro.generator} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=Instrument+Sans:ital,wght@0,400;0,500;1,400&display=swap"
      rel="stylesheet"
    />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="sitemap" href="/sitemap.xml" />
    <link rel="icon" href="/favicon.ico" />
    {
      rssAlternate && (
        <link
          rel="alternate"
          type="application/rss+xml"
          title={rssAlternate.title}
          href={rssAlternate.href}
        />
      )
    }
    {
      jsonLdBlocks.map((data) => (
        <script is:inline type="application/ld+json" set:html={JSON.stringify(data)} />
      ))
    }
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <header class="site-header">
      <nav aria-label="Primary">
        <a class="wordmark" href="/">Hive<span>RSS</span></a>
        <div class="nav-links">
          <a href="/#communities">Communities</a>
          <a href="https://github.com/hiveuprss/hiverss" target="_blank" rel="noopener">GitHub</a>
        </div>
      </nav>
    </header>

    <slot />

    <footer>
      <div class="footer-inner">
        <p class="footer-copy">HiveRSS — RSS feeds for the Hive blockchain</p>
        <div class="footer-links">
          <a href="https://github.com/hiveuprss/hiverss" target="_blank" rel="noopener">GitHub</a>
          <a href="https://hive.blog" target="_blank" rel="noopener">Hive</a>
          <a href="https://hiveposh.com" target="_blank" rel="noopener">HivePosh</a>
          <a href="https://hive.io" target="_blank" class="footer-powered" title="Powered by Hive">
            <img
              src="/badge-powered-by-hive.svg"
              alt="Powered by Hive"
              class="footer-hive-logo"
              width="102"
              height="36"
            />
          </a>
        </div>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  :root {
    --bg:            #0B0B0A;
    --surface:       #141413;
    --surface-2:     #1C1C1A;
    --surface-3:     #242422;
    --border:        #272725;
    --border-bright: #353532;
    --text:          #EEEDe6;
    --text-muted:    #888880;
    --text-dim:      #4A4A46;
    --red:           #E31337;
    --red-light:     #FF2D4F;
    --red-dim:       rgba(227, 19, 55, 0.08);
    --amber:         #F5A623;
    --amber-dim:     rgba(245, 166, 35, 0.08);
    --radius:        10px;
    --max-w:         1120px;
  }

  html {
    background: var(--bg);
    color: var(--text);
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  body {
    font-family: 'Instrument Sans', sans-serif;
    font-size: 1rem;
    line-height: 1.6;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  a { color: inherit; text-decoration: none; }

  .skip-link {
    position: absolute;
    left: -9999px;
    z-index: 100;
    padding: 0.75rem 1rem;
    background: var(--red);
    color: #fff;
    font-weight: 600;
    font-size: 0.875rem;
    border-radius: 0 0 8px 0;
    transition: left 0.15s;
  }
  .skip-link:focus {
    left: 0;
    outline: 2px solid var(--text);
    outline-offset: 2px;
  }

  .site-header nav {
    position: sticky;
    top: 0;
    z-index: 50;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.125rem 2rem;
    border-bottom: 1px solid var(--border);
    background: rgba(11, 11, 10, 0.85);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
  }

  h1, h2, h3, h4, h5 {
    font-family: 'Syne', sans-serif;
    line-height: 1.1;
  }

  .wordmark {
    font-family: 'Syne', sans-serif;
    font-weight: 800;
    font-size: 1.2rem;
    letter-spacing: -0.025em;
    color: var(--text);
    transition: opacity 0.15s;
  }
  .wordmark:hover { opacity: 0.8; }
  .wordmark span { color: var(--red); }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 1.75rem;
  }
  .nav-links a {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--text-muted);
    transition: color 0.15s;
  }
  .nav-links a:hover { color: var(--text); }

  /* ── Footer ── */
  footer {
    margin-top: auto;
    border-top: 1px solid var(--border);
    padding: 1.75rem 2rem;
  }
  .footer-inner {
    max-width: var(--max-w);
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .footer-copy {
    font-size: 0.8125rem;
    color: var(--text-dim);
  }
  .footer-links {
    display: flex;
    gap: 1.5rem;
  }
  .footer-links a {
    font-size: 0.8125rem;
    color: var(--text-dim);
    transition: color 0.15s;
  }
  .footer-links a:hover { color: var(--text-muted); }
  .footer-powered {
    display: inline-flex;
    align-items: center;
    opacity: 0.85;
    transition: opacity 0.15s;
  }
  .footer-powered:hover { opacity: 1; }
  .footer-hive-logo {
    display: block;
    height: 18px;
    width: auto;
  }

  @media (max-width: 600px) {
    .site-header nav { padding: 1rem 1.25rem; }
    .nav-links { gap: 1.25rem; }
    .footer-inner { flex-direction: column; gap: 0.75rem; text-align: center; }
  }
</style>
